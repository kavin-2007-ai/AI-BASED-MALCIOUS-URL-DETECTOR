{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run URL Sentinel AI (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Train ML Model",
      "type": "debugpy",
      "request": "launch",
      "module": "app.ml.train",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "Run Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_sentinel.py",
        "-v"
      ],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    }
  ]
}
